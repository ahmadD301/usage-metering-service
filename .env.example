# Copy to .env and adjust. Docker Compose reads it automatically.
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering_dev_password
POSTGRES_DB=metering
# Host port for Postgres (inside Compose the service always uses 5432).
# Use 5433 if something else already listens on 5432.
POSTGRES_PORT=5432

# Secret that allows creating accounts (at least 16 characters). Change it outside local dev.
ADMIN_TOKEN=dev-admin-token-change-me

# Host ports for the service and the demo page.
SERVICE_PORT=3000
CLIENT_PORT=8080